#!/usr/bin/env bash
# Outils de développement de Synatomo. La compilation tourne dans un conteneur
# plafonné en mémoire : le VPS ne doit jamais geler à cause d'un build.
# Usage : bin/dev cargo <args> | build | check | unit | run | stop | logs | seed | test | sh
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE=rust:1-slim-trixie
CACHE=synatomo_cache
PORT="${SYN_DEV_PORT:-8292}"
NAME=synatomo_dev

toolchain() {
  sudo -n docker volume inspect "$CACHE" >/dev/null 2>&1 || {
    sudo -n docker volume create "$CACHE" >/dev/null
    sudo -n docker run --rm -v "$CACHE":/cache "$IMAGE" chown 1000:1000 /cache
  }
  sudo -n docker run --rm --user 1000:1000 --memory 2500m --cpus 3 \
    -e HOME=/cache -e CARGO_HOME=/cache/cargo -e CARGO_TARGET_DIR=/cache/target -e CARGO_BUILD_JOBS=3 \
    -v "$CACHE":/cache -v "$ROOT":/src -w /src "$IMAGE" "$@"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  cargo) toolchain cargo "$@" ;;
  sh)    toolchain sh -c "$*" ;;
  check) toolchain cargo check "$@" ;;
  build) toolchain cargo build "$@" ;;
  unit)  toolchain cargo test "$@" ;;
  run)
    # Relance le serveur de dev sur 127.0.0.1:$PORT avec une base jetable (volume synatomo_devdata).
    sudo -n docker rm -f "$NAME" >/dev/null 2>&1 || true
    [ "${1:-}" = "--fresh" ] && sudo -n docker volume rm synatomo_devdata >/dev/null 2>&1 || true
    sudo -n docker run -d --name "$NAME" --memory 256m -p "127.0.0.1:$PORT:8292" \
      -e SYNATOMO_LISTEN=0.0.0.0:8292 -e SYNATOMO_DATA=/data -e SYNATOMO_DEV=1 \
      -v "$CACHE":/cache:ro -v synatomo_devdata:/data "$IMAGE" /cache/target/debug/synatomo serve >/dev/null
    echo "http://127.0.0.1:$PORT" ;;
  exec)  sudo -n docker exec -i "$NAME" /cache/target/debug/synatomo "$@" ;;
  stop)  sudo -n docker rm -f "$NAME" >/dev/null 2>&1 || true ;;
  logs)  sudo -n docker logs --tail "${1:-60}" "$NAME" ;;
  seed)  node "$ROOT/dev/seed.mjs" "$@" ;;
  test)  cd "$ROOT" && node --test "$@" tests/*.test.mjs ;;
  *) sed -n 2,4p "$0"; exit 1 ;;
esac
